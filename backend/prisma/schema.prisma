// Prisma schema for the Outreach CRM.
// Dev default is SQLite; swap the datasource to Postgres for production
// (see SETUP.md — it's a one-line change plus a fresh migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Platform-level flag: can manage Companies across the whole app (create,
  // suspend, see aggregate usage). Distinct from `role` below, which is
  // scoped to this user's own Company. isAdmin is you; role is "am I the
  // owner of my company's workspace, or just a member of it."
  isAdmin      Boolean  @default(false)
  // Access is invite/approval-gated, not open self-registration: new accounts
  // start unapproved and can't log in until an admin approves them (or, once
  // Companies exist, until a company owner invites them directly — see
  // routes/companies.js). The very first user ever created is auto-promoted
  // to admin+approved (bootstrap), see auth.js register + server.js startup
  // safety net.
  approved     Boolean  @default(false)
  // Nullable only so existing deploys can migrate cleanly (see
  // ensureCompanyAssignment in server.js, which backfills every pre-existing
  // user into one legacy Company on boot) — in practice every user always
  // belongs to exactly one company from that point on.
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Within-company role: "owner" can invite/remove teammates and (re)connect
  // the company's shared Gmail account; "member" shares the same contacts/
  // sequences/templates/campaigns but can't manage who's on the team.
  role         String   @default("member") // owner | member
  createdAt    DateTime @default(now())

  contacts             Contact[]
  sequences            Sequence[]
  templates            Template[]
  offers               Offer[]
  contactNotes         ContactNote[]
  emailLogs            EmailLog[]
  campaigns            Campaign[]
  // Historical audit relation only now (see GmailAccount.userId) — no longer
  // the access boundary, and no longer guaranteed unique per user, hence a
  // list rather than GmailAccount? as it was before.
  connectedGmailAccounts GmailAccount[]
  passwordResetTokens  PasswordResetToken[]
  // A user can belong to more than one Company now (e.g. owner of their own
  // workspace, member of a client's) — see Membership below. companyId/role
  // above stay as-is as the "default/home" company: whichever membership is
  // active when there's no explicit switch in the session (see
  // lib/membership.js#resolveMembershipContext). Every existing route still
  // just reads req.user.companyId/req.user.role, resolved from the active
  // membership by requireAuth — nothing downstream needed to change.
  memberships          Membership[]
  // Invites this user has SENT (as a company owner) to existing accounts —
  // audit only, see CompanyInvite. Named to avoid any ambiguity with
  // `memberships` above (invites the user has *received* aren't a relation
  // at all — they're looked up by matching email, see lib/invites.js, since
  // an invite can exist before the invitee even has this in mind).
  sentInvites          CompanyInvite[] @relation("SentInvites")
  auditLogs            AuditLog[]

  @@index([companyId])
}

// Join table making User<->Company many-to-many. One row per (user, company)
// pair, each with its own role — the same person can be "owner" of one
// company and "member" of another. Existing single-company users get exactly
// one row here (backfilled on boot from User.companyId/role — see
// ensureMembershipsBackfilled in server.js), so nothing about their
// day-to-day experience changes; this only matters once someone is added to
// a second company.
model Membership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String   @default("member") // owner | member — scoped to this one company, not global
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

// A pending invitation for an EXISTING account (matched by email) to join a
// company — the consent step between "an owner wants to add this person"
// and a Membership actually existing. Distinct from the direct-invite path
// in routes/team.js (POST /team), which only ever creates a brand-new
// account: that one never needs consent because the owner is the one
// creating the account in the first place. This one is for someone who
// already has their own account/password elsewhere, so a Membership only
// gets created once THEY accept — an owner can't unilaterally attach an
// existing person's account to their company.
model CompanyInvite {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Lowercased, matched against the invitee's own email at accept/decline
  // time — not a foreign key to User, since the whole point is this can be
  // sent to an email address without coupling to a specific account id.
  email       String
  role        String    @default("member") // owner | member — what they get if they accept
  invitedById String?
  invitedBy   User?     @relation("SentInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  status      String    @default("pending") // pending | accepted | declined | revoked
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([companyId])
  @@index([email, status])
}

// Append-only trail of high-impact admin/owner actions (suspend a company,
// remove someone's access, delete an account, etc.) — nothing in the app
// reads this to make decisions, it exists purely so there's a record once
// more than one admin/owner is operating. actorEmail is denormalized (kept
// even if the actor's own account is later deleted) so an entry still reads
// sensibly; actorId/companyId are both nullable + SetNull for the same
// "never let cleanup elsewhere silently erase history" reason.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String // short machine key, e.g. "company.suspend", "team.remove"
  summary    String // human-readable one-liner, prebuilt at write time — see lib/auditLog.js
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([createdAt])
}

// A tenant. Each pilot company is one Company row; every User belongs to
// exactly one, and (as of this round) contacts/sequences/templates/offers/
// campaigns/email history/the connected Gmail account are all shared across
// everyone in the same company rather than private to one person.
model Company {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("active") // active | suspended — suspended blocks login for every user in it, see requireAuth
  createdAt DateTime @default(now())

  // Business/legal profile — entirely optional (a pilot company can start
  // with just a name and fill these in later, or never). Greek-business
  // oriented since that's this app's primary market: legalName is the full
  // registered "επωνυμία" (may differ from the display `name` above), taxId
  // is the ΑΦΜ, taxOffice is the ΔΟΥ, gemhNumber is the ΓΕΜΗ registry number.
  // Not validated for format/checksum — just free text, since the point is
  // having a place to keep them, not enforcing tax-authority rules.
  legalName  String?
  taxId      String? // ΑΦΜ
  taxOffice  String? // ΔΟΥ
  gemhNumber String? // ΓΕΜΗ
  address    String?
  phone      String?
  email      String?
  // Last time the weekly performance digest (lib/weeklyDigest.js) was sent
  // to this company's owner(s). Null means "never sent" — treated the same
  // as "more than 7 days ago" so a brand-new company gets its first digest
  // on the next scheduler pass rather than waiting a full week.
  lastDigestSentAt DateTime?

  // Timezone-aware send window. When enabled, the scheduler only sends
  // sequence steps and campaign emails during these hours/days in
  // sendTimezone, deferring anything that falls outside — so cold outreach
  // lands during the target market's business hours instead of at 3am.
  // Disabled by default so existing companies keep sending 24/7 until an
  // owner turns it on. Hours are local to sendTimezone: [start, end), 0-23.
  // sendDays is the allowed weekdays as ints, 0=Sunday..6=Saturday.
  sendWindowEnabled Boolean @default(false)
  sendWindowStart   Int     @default(9)
  sendWindowEnd     Int     @default(17)
  sendDays          Json    @default("[1,2,3,4,5]")
  sendTimezone      String  @default("Europe/Athens")

  users        User[]
  contacts     Contact[]
  sequences    Sequence[]
  templates    Template[]
  offers       Offer[]
  contactNotes ContactNote[]
  emailLogs    EmailLog[]
  campaigns    Campaign[]
  // A list now, not a single optional object — GmailAccount.companyId lost
  // its @unique constraint this round (see that model's comment) so a
  // company can have more than one connected mailbox. A to-one Prisma
  // relation requires a unique foreign key on the referencing side, so this
  // HAD to become a list in lockstep with that change, or schema validation
  // would fail (a stale to-one relation pointing at a now-non-unique field).
  gmailAccounts GmailAccount[]
  memberships  Membership[]
  invites      CompanyInvite[]
  auditLogs    AuditLog[]
  integrations Integration[]
  metaLeadConnections MetaLeadConnection[]
  linkedinLeadConnections LinkedInLeadConnection[]
  // LinkedIn OUTREACH (Unipile) — distinct from linkedinLeadConnections above,
  // which is the official inbound Lead Gen integration. See LinkedIn module.
  linkedinOutreachAccount LinkedInOutreachAccount?
  linkedinActions         LinkedInAction[]
}

// A generic inbound-lead webhook, one (or more) per company. Covers
// WordPress form plugins (Contact Form 7 + a webhook add-on, Gravity Forms,
// WPForms, Fluent Forms — all of which already support POSTing to an
// arbitrary URL on submit) and any other leadgen/landing-page tool with an
// outgoing-webhook or Zapier/Make option, with zero per-source code needed:
// they all just get told to POST at
// `${API_URL}/integrations/inbound/:token`. The token alone is the auth —
// deliberately unauthenticated in the session sense (the sender is a third
// party's server, not a logged-in user) but unguessable and revocable, same
// posture as EmailLog.trackingId elsewhere in this schema.
model Integration {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Only "generic_webhook" exists today — kept as a string (not an enum) in
  // case a source-specific variant is ever needed without a migration.
  type           String    @default("generic_webhook")
  // Owner-facing label so a company with multiple inbound sources (e.g. one
  // per WordPress site) can tell them apart — purely cosmetic.
  name           String?
  token          String    @unique
  active         Boolean   @default(true)
  lastReceivedAt DateTime?
  receivedCount  Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([companyId])
}

// A connected Meta (Facebook/Instagram) Lead Ads page, direct Graph API
// integration rather than the generic webhook above — Meta doesn't let an
// arbitrary URL receive full lead data, only a "a new lead exists, here's
// its id" ping at one single app-level webhook URL (see
// routes/integrations.js's /meta/webhook), which then has to call back into
// the Graph API with a page access token to fetch the actual answers. pageId
// is how an inbound ping (which only carries Meta's own page-scoped IDs) is
// mapped back to which company it belongs to.
model MetaLeadConnection {
  id                       String    @id @default(uuid())
  companyId                String
  company                  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pageId                   String    @unique
  pageName                 String?
  // AES-256-GCM encrypted before storage, same helper as GmailAccount's
  // tokens — see src/lib/crypto.js. A long-lived Page Access Token, pasted in
  // by the owner today (see SETUP.md) rather than obtained via an in-app
  // OAuth connect flow, since discovering a user's pages via `pages_show_list`
  // is itself gated behind the same Meta App Review as `leads_retrieval`.
  encryptedPageAccessToken String
  active                   Boolean   @default(true)
  lastReceivedAt           DateTime?
  receivedCount            Int       @default(0)
  createdAt                DateTime  @default(now())

  @@index([companyId])
}

// Short-lived, single-use tokens for the "forgot password" flow. Only a
// hash of the token is stored — the raw token exists only in the emailed
// link, exactly like a password: if the DB leaks, the hashes alone can't
// be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Reusable email templates. Sequence steps can be created from a template
// (its subject/body are copied in at that moment) or written inline —
// editing a template later never retroactively changes steps that already
// used it, so an in-flight sequence can't change under an enrolled contact.
model Template {
  id          String   @id @default(uuid())
  userId      String? // who created it — audit only; SetNull so removing a teammate never deletes shared templates
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  body        String
  // [{filename, mimeType, contentBase64}] — small files only (capped at the
  // app layer, ~2MB/file); simplest option with no external storage service.
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A connected Gmail mailbox used for sending. Separate from User so login
// (email/password) and the Gmail connection can change independently — e.g.
// reconnecting a different Gmail account later.
//
// A company can now have MORE THAN ONE of these (companyId is no longer
// @unique — see lib/emailCap.js#pickSendableMailbox, which round-robins
// across every healthy, under-cap mailbox for a company). This is purely
// additive: a company that has only ever connected one mailbox behaves
// exactly as before, just with a "pool" of size one.
model GmailAccount {
  id                    String   @id @default(uuid())
  // Historical: who performed the OAuth connect — audit only now, not the
  // access boundary. Was `@unique` (one mailbox per person); now nullable and
  // non-unique on purpose, since a mailbox is shared company-wide (companyId
  // below is the real access boundary) rather than owned by one individual.
  // Deliberately NOT dropped/renamed (only relaxed) so this schema change
  // can't trigger a destructive column-drop against the live table.
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Nullable for the same migration reason as User.companyId —
  // ensureCompanyAssignment (server.js) backfills it on boot, and every
  // write path after that guarantees it's set. No longer @unique (see model
  // comment above) — was relaxed once already for a different reason
  // (nullable), this round drops the uniqueness constraint itself so a
  // company can connect more than one mailbox.
  companyId             String?
  company               Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  googleId              String   @unique
  email                 String
  // AES-256-GCM encrypted before storage — see src/lib/crypto.js
  encryptedAccessToken  String
  encryptedRefreshToken String
  tokenExpiry           DateTime
  emailsSentToday       Int      @default(0)
  sendCounterResetAt    DateTime @default(now())
  createdAt             DateTime @default(now())
  // Set when a send attempt fails with a Gmail auth error (revoked access,
  // expired/invalid refresh token) — see lib/gmailClient.js#isAuthError. Once
  // set, the scheduler stops attempting sends for this account (no point
  // hammering a known-broken connection every tick) until an owner
  // reconnects, which clears both fields (see routes/auth.js google/callback).
  needsReconnect        Boolean   @default(false)
  authErrorAt           DateTime?
  // Round-robin cursor: whichever healthy, under-cap mailbox in the company's
  // pool was used longest ago (or never) is picked next — see
  // lib/emailCap.js#pickSendableMailbox. Null means "never sent from,"
  // which naturally sorts first (a brand-new mailbox gets used immediately
  // rather than waiting behind ones with real send history).
  lastUsedAt            DateTime?

  @@index([companyId])
}

// A connected LinkedIn organization (Company Page / ad account) for Lead
// Gen Forms — the third lead-intake source alongside Integration (generic
// webhook) and MetaLeadConnection. Unlike Meta, LinkedIn's OAuth is a
// standard 3-legged flow (see lib/linkedinLeads.js), so the owner
// authenticates via a real "Connect LinkedIn" redirect rather than pasting a
// token — but the underlying `r_marketing_leadgen_automation` scope only
// actually returns lead data once LinkedIn has approved this app for its
// separate, application-based Lead Sync API program (see SETUP.md — this
// approval is slower and less guaranteed than Meta's App Review). Both a
// real-time webhook AND a periodic reconciliation poll feed leads in (see
// scheduler.js's linkedinReconciliationTick) — LinkedIn's own docs note
// webhook deliveries can be missed/duplicated, so the poll is a belt-and
// -suspenders backstop, not a replacement for the webhook.
model LinkedInLeadConnection {
  id                        String    @id @default(uuid())
  companyId                 String
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // e.g. "urn:li:organization:12345" — how an inbound webhook notification
  // (which carries LinkedIn's own URNs, not our ids) is mapped back to which
  // company it belongs to, same role as MetaLeadConnection.pageId.
  organizationUrn           String    @unique
  organizationName          String?
  // AES-256-GCM encrypted before storage, same helper as GmailAccount/
  // MetaLeadConnection — see src/lib/crypto.js.
  encryptedAccessToken      String
  // Nullable: LinkedIn only issues a refresh token for apps with
  // "Programmatic Refresh Token" access (itself a separate, approval-gated
  // product) — without it, the access token simply has to be re-authorized
  // (owner clicks "Σύνδεση LinkedIn" again) before/after it expires.
  encryptedRefreshToken     String?
  tokenExpiry               DateTime?
  // Same meaning/handling as GmailAccount.needsReconnect — set when a token
  // has expired or a call fails with an auth error; the reconciliation poll
  // skips connections in this state until the owner reconnects.
  needsReconnect            Boolean   @default(false)
  active                    Boolean   @default(true)
  lastReceivedAt            DateTime?
  // Bookmark for the reconciliation poll — "fetch anything created since
  // this timestamp," advanced after each successful poll pass.
  lastPolledAt              DateTime?
  receivedCount             Int       @default(0)
  createdAt                 DateTime  @default(now())

  @@index([companyId])
}

model Contact {
  id             String   @id @default(uuid())
  // Who added this contact — audit only, not the access boundary (see
  // companyId). Nullable + onDelete: SetNull (not Cascade) on purpose: this
  // data belongs to the company, shared with every teammate, so removing one
  // team member must never delete the contacts the whole team relies on —
  // only the "added by" attribution goes away.
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Access boundary: every route filters on companyId, so a contact is
  // visible/editable by anyone on the same company's team, not just whoever
  // created it. Nullable only for the pre-existing-data migration — see
  // ensureCompanyAssignment in server.js.
  companyId      String?
  // Named `workspace`, not `company` — Contact already has a plain-text
  // `company` field below (the contact's employer/business name, used as
  // the {{company}} merge token) and Prisma doesn't allow two fields with
  // the same name on one model. Nothing in the codebase traverses this
  // relation as an object (every query filters by the companyId scalar
  // instead), so renaming just this side is safe — see lib/gmailClient.js
  // for the unrelated string field this would otherwise collide with.
  workspace      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  // Structured given/family name — separate from `name` on purpose: `name`
  // stays the free-text display name used for {{name}} personalization
  // (may be a full name, a nickname, whatever reads best in an email), while
  // firstName/lastName back the {{first_name}}/{{last_name}} merge tokens
  // and can be used for filtering/sorting without depending on splitting
  // `name` on whitespace (which breaks for multi-word first/last names).
  firstName      String?  @default("")
  lastName       String?  @default("")
  email          String
  phone          String?  @default("")
  company        String?
  category       String?  @default("") // free-text bucket, e.g. Lead / Πελάτης / Συνεργάτης — used for filtering
  tags           String   @default("") // comma-separated; fine at this scale
  website        String?  @default("") // usable as {{website}} in email bodies
  // A link to a personalized report/proposal for this contact (e.g. a
  // one-pager hosted elsewhere) — usable as {{report_link}} in email bodies,
  // resolved the same way as any other merge token, no click-tracking of its
  // own (unlike real send-time {{unsubscribe_link}} resolution).
  reportLink     String?  @default("")
  // Online-presence links for local-business outreach — same treatment as
  // website/reportLink (scheme-sanitized on write, usable as merge tokens).
  // "gmb" (not the full "Google My Business") is the field's own short label
  // in the UI, not an abbreviation of what's stored — it just holds the
  // profile URL like the other three.
  gmb            String?  @default("") // Google My Business profile link — {{gmb}}
  facebook       String?  @default("") // {{facebook}}
  instagram      String?  @default("") // {{instagram}}
  googleReviews  String?  @default("") // {{google_reviews}}
  // LinkedIn outreach (second channel on the SAME contact — see LinkedIn module).
  // profileUrl is what the user enters; providerId is resolved once via Unipile
  // and cached here; connectionStatus tracks the invite lifecycle. All contact-
  // level state, exactly like the social URLs above and `status`/`unsubscribed`.
  linkedinProfileUrl       String? @default("") // {{linkedin}}
  linkedinProviderId       String? @default("") // Unipile-resolved provider id (empty until resolved)
  linkedinConnectionStatus String? @default("") // ""|not_sent|pending|accepted|declined|withdrawn|connected
  // Freeform personalization notes about this specific contact (what they do,
  // something they mentioned, a pain point) — separate from ContactNote
  // (timestamped CRM activity log). Usable as a merge field via {{comments}}
  // in any template/compose/step body, same mechanism as {{name}}/{{company}}.
  // Stores rich-text HTML (bold/italic/lists) now, not plain text — same
  // RichTextEditor used for template/compose bodies — since it's injected
  // directly into the outgoing email HTML as-is.
  comments       String?  @default("")
  // Private, internal-only notes — never sent in an email, never used as a
  // merge field. Distinct from `comments` (which IS used as {{comments}} in
  // emails) precisely so a stray personal note about a contact can never
  // accidentally end up in an outgoing message.
  internalNotes  String?  @default("")
  // Optional IANA timezone for this contact (e.g. "Europe/London"). When set,
  // the company's send window (hours/days) is evaluated in THIS contact's local
  // time instead of the company default — so a step scheduled for "business
  // hours" actually lands in the recipient's business hours. Empty/unknown
  // falls back to the company timezone. See lib/sendWindow.js.
  timezone       String?  @default("")
  status         String   @default("new") // new | contacted | opened | replied | bounced | unsubscribed
  unsubscribed   Boolean  @default(false)
  unsubscribedAt DateTime? // when unsubscribed flipped true — via the email footer link, or manually in-app
  lastActivityAt DateTime?
  nextFollowUpAt DateTime? // manual reminder date, independent of automatic sequence sends
  createdAt      DateTime @default(now())

  enrollments        Enrollment[]
  offers             Offer[]
  notes              ContactNote[]
  emailLogs          EmailLog[]
  campaignRecipients CampaignRecipient[]
  linkedinActions    LinkedInAction[]

  @@index([userId, email])
  @@index([userId, category])
  @@index([userId, nextFollowUpAt])
  @@index([companyId, email])
  @@index([companyId, category])
  @@index([companyId, nextFollowUpAt])
  @@index([companyId, unsubscribed])
}

// A lightweight deal/pipeline tracker — separate from Sequence/EmailLog
// because an offer's lifecycle (draft -> sent -> accepted/declined) is a
// sales-side concern, not an email-send-side one, and a contact may have
// several offers over time.
model Offer {
  id        String   @id @default(uuid())
  userId    String? // who created it — audit only; SetNull so removing a teammate never deletes the deal
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  value     Float?
  currency  String   @default("EUR")
  status        String   @default("draft") // draft | sent | accepted | declined
  notes         String?
  // Freeform "why" behind an accepted/declined outcome — feeds the CRM
  // business reporting (win rate + reasons breakdown), not just email metrics.
  outcomeReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([companyId, status])
  @@index([contactId])
}

// Freeform CRM notes on a contact, for follow-up context that doesn't fit
// any structured field.
model ContactNote {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String? // who wrote it — audit only; SetNull so removing a teammate never deletes the note
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Sequence {
  id        String   @id @default(uuid())
  userId    String? // who created it — audit only; SetNull so removing a teammate never deletes shared sequences
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  // Which channel this sequence runs on. "email" (default) is the existing
  // Gmail path; "linkedin" runs the same step engine but sends via the
  // connected LinkedIn account (Unipile) — first step becomes a connection
  // request for non-connections, follow-ups fire on the "connection accepted"
  // event. A sequence is single-channel for the MVP.
  channel   String   @default("email") // email | linkedin
  // LinkedIn only: the connection-request note sent when an enrolled contact
  // isn't a 1st-degree connection yet. Once accepted, the sequence's steps run
  // as direct messages. Ignored for email sequences.
  linkedinConnectionNote String? @default("")
  createdAt DateTime @default(now())

  steps       SequenceStep[]
  enrollments Enrollment[]
}

model SequenceStep {
  id               String    @id @default(uuid())
  sequenceId       String
  sequence         Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order            Int
  subject          String
  // A/B subject testing: additional subject lines. When non-empty, each send
  // picks uniformly at random from [subject, ...subjectVariants], and the one
  // actually used is recorded in EmailLog.subject — so open-rate-by-subject
  // (see /analytics/ab-tests) tells you which line wins. Empty = no test, the
  // single `subject` above is always used. Shape: string[].
  subjectVariants  Json     @default("[]")
  body             String   // HTML, may contain {{name}}, {{company}}, {{email}} placeholders
  delayDays        Int      @default(0) // days after previous step (0 for the first step)
  sourceTemplateId String?  // informational only — which template this was copied from, if any
  // Combinable gating conditions, evaluated by the scheduler right before
  // sending — on top of (not instead of) delayDays. If unmet, this step is
  // skipped (not retried) and the enrollment moves on to the next one.
  // Shape: { requireEvent?: "opened"|"clicked"|"not_opened"|"not_clicked", requireTags?: string[] }
  conditions       Json      @default("{}")
  // [{filename, mimeType, contentBase64}] — copied in from the template at
  // creation time, same rule as subject/body.
  attachments      Json      @default("[]")

  emailLogs EmailLog[]

  @@index([sequenceId, order])
}

model Enrollment {
  id           String    @id @default(uuid())
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequenceId   String
  sequence     Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  currentStep  Int       @default(0) // index into the sequence's ordered steps
  status       String    @default("active") // active | completed | paused | replied | bounced
  nextSendAt   DateTime
  createdAt    DateTime  @default(now())

  emailLogs EmailLog[]

  @@index([status, nextSendAt])
  @@index([contactId])
}

model EmailLog {
  id             String      @id @default(uuid())
  // Nullable because manual one-off sends (source = "manual") don't belong to
  // an enrollment/step at all — only sequence-driven sends do.
  enrollmentId   String?
  enrollment     Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId         String?
  step           SequenceStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  // Nullable for the same reason — only campaign blasts (source = "campaign")
  // set this.
  campaignId     String?
  campaign       Campaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Denormalized onto every row (not just derived via enrollment->contact) so
  // manual sends, sequence sends, and campaign sends all share one query
  // shape everywhere else in the app (Inbox view, contact timeline, analytics).
  contactId      String
  contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId         String? // who sent it — audit only; SetNull so removing a teammate never deletes send history
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subject        String      @default("")
  source         String      @default("sequence") // sequence | manual | campaign
  attachments    Json        @default("[]") // kept for history/audit, same shape as SequenceStep.attachments
  gmailMessageId String?
  trackingId     String      @unique
  sentAt         DateTime    @default(now())

  events TrackingEvent[]

  @@index([userId, sentAt])
  @@index([companyId, sentAt])
  @@index([contactId])
  @@index([campaignId])
}

// A one-shot blast of a single subject/body (usually copied in from a
// Template, same "snapshot at creation time" rule as SequenceStep — editing
// the template later never changes a campaign that already copied it) to a
// chosen set of contacts. Distinct from Sequence: a sequence is a multi-step
// nurture with day-scale delays per contact; a campaign is one message sent
// to many contacts, spaced out one-by-one so as not to look like a
// mail-blast to Gmail/the recipients — see CampaignRecipient + the campaign
// tick in scheduler.js.
model Campaign {
  id              String    @id @default(uuid())
  userId          String? // who created it — audit only; SetNull so removing a teammate never deletes it
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  subject         String
  // A/B subject testing — same mechanism as SequenceStep.subjectVariants:
  // when non-empty, each recipient's send picks at random from
  // [subject, ...subjectVariants] and the chosen line is stored in
  // EmailLog.subject for per-variant open-rate reporting. Shape: string[].
  subjectVariants Json      @default("[]")
  body            String
  attachments     Json      @default("[]")
  status          String    @default("draft") // draft | running | paused | completed
  // Minutes between consecutive sends within this campaign — the scheduler's
  // campaign tick checks lastSentAt + intervalMinutes before sending the next
  // pending recipient, rather than pre-computing every recipient's send time
  // up front, so pause/resume just works with no rescheduling needed.
  intervalMinutes Int       @default(2)
  lastSentAt      DateTime?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  recipients CampaignRecipient[]
  emailLogs  EmailLog[]

  @@index([userId, status])
  @@index([companyId, status])
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  order      Int // stable send order, set at creation time (selection order)
  status     String    @default("pending") // pending | sent | skipped | failed
  sentAt     DateTime?
  // Why a recipient was skipped/failed instead of sent — e.g. "unsubscribed",
  // or the Gmail API error message for a failed send.
  note       String?

  @@index([campaignId, status, order])
}

model TrackingEvent {
  id          String   @id @default(uuid())
  emailLogId  String
  emailLog    EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)
  type        String   // open | click
  url         String?  // only set for click events
  userAgent   String?  // raw UA of whatever requested the pixel/link — kept for audits
  // Pixel opens are notoriously unreliable: Gmail/Google auto-fetch tracking
  // pixels on delivery via a well-documented bot User-Agent (see
  // isLikelyBotOpen in routes/tracking.js), and viewing your own sent copy in
  // the Sent folder fires the exact same pixel as a genuine recipient open.
  // isBot flags opens we're confident aren't a real human looking at the
  // email, so they're excluded from "opened" everywhere (contact status,
  // analytics, sequence "wait for open" conditions) instead of inflating
  // open rates.
  isBot       Boolean  @default(false)
  occurredAt  DateTime @default(now())

  // Queried by emailLogId directly (tracking.js) and joined via
  // emailLog.userId in analytics.js's /timeline — neither had an index to
  // use before this, meaning both went through a full scan as this table
  // grows (one row per open/click, so it grows fast).
  @@index([emailLogId])
}

// Failed webhook deliveries from Meta Lead Ads, generic webhooks, etc. —
// persisted so we can retry on transient failures (DB hiccup, network timeout)
// and provide visibility into what was attempted. LinkedIn webhooks don't need
// this because the reconciliation poll in scheduler.js is the belt-and-
// suspenders backstop. Failed deliveries are retried hourly (see scheduler.js's
// webhookRetryTick) up to 3 times; after that they move to "retry_exhausted"
// and require manual investigation.
model FailedWebhookDelivery {
  id          String   @id @default(cuid())
  type        String   // "meta" | "generic" | "linkedin"
  payload     String   // raw JSON string of original webhook body
  status      String   @default("pending") // "pending" | "failed" | "retry_exhausted"
  retryCount  Int      @default(0)
  lastError   String?  // error message from most recent retry attempt
  nextRetryAt DateTime? // when to retry next (null = not yet scheduled)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, nextRetryAt])
}

// ---------------------------------------------------------------------------
// LinkedIn OUTREACH module (Unipile). Distinct from the official inbound
// LinkedInLeadConnection / linkedinLeads.js above — this is outbound connection
// requests + messaging over Unipile's (unofficial) API.
// ---------------------------------------------------------------------------

// Platform-wide key/value settings, edited by platform admins in the SuperAdmin
// view. Key/value so new integration credentials can be added without a
// migration; secret values are AES-256-GCM encrypted at rest (isSecret=true),
// the same mechanism as Gmail tokens (lib/crypto.js). Powers the Unipile
// DSN/access token behind the LinkedIn module.
model PlatformSetting {
  key       String   @id
  value     String   @default("") // plaintext for config; AES-256-GCM ciphertext when isSecret
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// A company's connected LinkedIn account for OUTREACH via Unipile. One per
// company for the MVP (Phase 1). Rate-limit counters live HERE, not in memory,
// so a scheduler restart/redeploy can't reset them and blow past the daily cap
// — a hard requirement to avoid LinkedIn account bans.
model LinkedInOutreachAccount {
  id               String   @id @default(uuid())
  companyId        String   @unique
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId           String?  // who connected it — audit only
  unipileAccountId String   @unique // Unipile's account id for this LinkedIn login
  status           String   @default("ok") // ok | checkpoint_needed | error | paused
  statusMessage    String?  // last error/checkpoint detail from Unipile
  paused           Boolean  @default(false) // manual kill-switch (safety rules require this)
  // DB-backed daily rate limiting (per account), reset ~every 24h by the tick.
  connectionsSentToday Int      @default(0)
  messagesSentToday    Int      @default(0)
  counterResetAt       DateTime @default(now())
  connectedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  actions LinkedInAction[]
}

// One LinkedIn outreach action against one contact — the LinkedIn analogue of
// EmailLog. LinkedIn has no opens/clicks, so it's its own funnel (accept/reply),
// not part of the email analytics. Drives the scheduler's LinkedIn tick.
model LinkedInAction {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         String   // connection_request | message
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accountId    String
  account      LinkedInOutreachAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  enrollmentId String?  // set when the action originates from a linkedin sequence step
  stepId       String?
  text         String   @default("") // invite note or message body (rendered with merge tokens)
  status       String   @default("pending") // pending|sent|accepted|declined|withdrawn|failed|skipped
  errorMessage String?
  unipileId    String?  // Unipile invite/message id, for later status lookups
  scheduledAt  DateTime @default(now())
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([companyId, type, status])
  @@index([contactId])
  @@index([status, scheduledAt])
}
