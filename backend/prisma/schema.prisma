// Prisma schema for the Outreach CRM.
// Dev default is SQLite; swap the datasource to Postgres for production
// (see SETUP.md — it's a one-line change plus a fresh migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Access is invite/approval-gated, not open self-registration: new accounts
  // start unapproved and can't log in until an admin approves them. The very
  // first user ever created is auto-promoted to admin+approved (bootstrap),
  // see auth.js register + server.js startup safety net.
  isAdmin      Boolean  @default(false)
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  contacts             Contact[]
  sequences            Sequence[]
  templates            Template[]
  offers               Offer[]
  contactNotes         ContactNote[]
  emailLogs            EmailLog[]
  gmailAccount         GmailAccount?
  passwordResetTokens  PasswordResetToken[]
}

// Short-lived, single-use tokens for the "forgot password" flow. Only a
// hash of the token is stored — the raw token exists only in the emailed
// link, exactly like a password: if the DB leaks, the hashes alone can't
// be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Reusable email templates. Sequence steps can be created from a template
// (its subject/body are copied in at that moment) or written inline —
// editing a template later never retroactively changes steps that already
// used it, so an in-flight sequence can't change under an enrolled contact.
model Template {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  body        String
  // [{filename, mimeType, contentBase64}] — small files only (capped at the
  // app layer, ~2MB/file); simplest option with no external storage service.
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A user's connected Gmail account, used only for sending. Separate from
// User so login (email/password) and the Gmail connection can change
// independently — e.g. reconnecting a different Gmail account later.
model GmailAccount {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleId              String   @unique
  email                 String
  // AES-256-GCM encrypted before storage — see src/lib/crypto.js
  encryptedAccessToken  String
  encryptedRefreshToken String
  tokenExpiry           DateTime
  emailsSentToday       Int      @default(0)
  sendCounterResetAt    DateTime @default(now())
  createdAt             DateTime @default(now())
}

model Contact {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String?  @default("")
  company        String?
  category       String?  @default("") // free-text bucket, e.g. Lead / Πελάτης / Συνεργάτης — used for filtering
  tags           String   @default("") // comma-separated; fine at this scale
  status         String   @default("new") // new | contacted | opened | replied | bounced | unsubscribed
  unsubscribed   Boolean  @default(false)
  lastActivityAt DateTime?
  nextFollowUpAt DateTime? // manual reminder date, independent of automatic sequence sends
  createdAt      DateTime @default(now())

  enrollments Enrollment[]
  offers      Offer[]
  notes       ContactNote[]
  emailLogs   EmailLog[]

  @@index([userId, email])
  @@index([userId, category])
  @@index([userId, nextFollowUpAt])
}

// A lightweight deal/pipeline tracker — separate from Sequence/EmailLog
// because an offer's lifecycle (draft -> sent -> accepted/declined) is a
// sales-side concern, not an email-send-side one, and a contact may have
// several offers over time.
model Offer {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  value     Float?
  currency  String   @default("EUR")
  status        String   @default("draft") // draft | sent | accepted | declined
  notes         String?
  // Freeform "why" behind an accepted/declined outcome — feeds the CRM
  // business reporting (win rate + reasons breakdown), not just email metrics.
  outcomeReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([contactId])
}

// Freeform CRM notes on a contact, for follow-up context that doesn't fit
// any structured field.
model ContactNote {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Sequence {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  steps       SequenceStep[]
  enrollments Enrollment[]
}

model SequenceStep {
  id               String    @id @default(uuid())
  sequenceId       String
  sequence         Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order            Int
  subject          String
  body             String   // HTML, may contain {{name}}, {{company}}, {{email}} placeholders
  delayDays        Int      @default(0) // days after previous step (0 for the first step)
  sourceTemplateId String?  // informational only — which template this was copied from, if any
  // Combinable gating conditions, evaluated by the scheduler right before
  // sending — on top of (not instead of) delayDays. If unmet, this step is
  // skipped (not retried) and the enrollment moves on to the next one.
  // Shape: { requireEvent?: "opened"|"clicked"|"not_opened"|"not_clicked", requireTags?: string[] }
  conditions       Json      @default("{}")
  // [{filename, mimeType, contentBase64}] — copied in from the template at
  // creation time, same rule as subject/body.
  attachments      Json      @default("[]")

  emailLogs EmailLog[]

  @@index([sequenceId, order])
}

model Enrollment {
  id           String    @id @default(uuid())
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequenceId   String
  sequence     Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  currentStep  Int       @default(0) // index into the sequence's ordered steps
  status       String    @default("active") // active | completed | paused | replied | bounced
  nextSendAt   DateTime
  createdAt    DateTime  @default(now())

  emailLogs EmailLog[]

  @@index([status, nextSendAt])
}

model EmailLog {
  id             String      @id @default(uuid())
  // Nullable because manual one-off sends (source = "manual") don't belong to
  // an enrollment/step at all — only sequence-driven sends do.
  enrollmentId   String?
  enrollment     Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId         String?
  step           SequenceStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  // Denormalized onto every row (not just derived via enrollment->contact) so
  // manual sends and sequence sends share one query shape everywhere else in
  // the app (Inbox view, contact timeline, analytics).
  contactId      String
  contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        String      @default("")
  source         String      @default("sequence") // sequence | manual
  attachments    Json        @default("[]") // kept for history/audit, same shape as SequenceStep.attachments
  gmailMessageId String?
  trackingId     String      @unique
  sentAt         DateTime    @default(now())

  events TrackingEvent[]

  @@index([userId, sentAt])
  @@index([contactId])
}

model TrackingEvent {
  id          String   @id @default(uuid())
  emailLogId  String
  emailLog    EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)
  type        String   // open | click
  url         String?  // only set for click events
  occurredAt  DateTime @default(now())
}
