# ---- Server ----
PORT=4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ---- Database ----
# Local dev: SQLite is fine. Production: use Postgres (see SETUP.md).
DATABASE_URL="file:./dev.db"

# ---- Sessions ----
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_64_hex_chars

# ---- Token encryption (AES-256-GCM) ----
# Generate with: openssl rand -hex 32
# This key encrypts Gmail OAuth tokens at rest. Losing it = losing access to
# all connected Gmail accounts (they'll need to reconnect). Never commit it.
ENCRYPTION_KEY=replace_with_64_hex_chars

# ---- Google OAuth / Gmail API ----
# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---- Sending safety ----
# Hard cap on emails sent per day per connected account, enforced by the
# scheduler regardless of how many sequence steps are due. Keep well under
# Gmail's own limit (500/day personal, 2000/day Workspace) to protect
# deliverability and avoid account flags.
MAX_EMAILS_PER_DAY_PER_ACCOUNT=300

# ---- System emails (password reset) ----
# Deliberately separate from the Gmail OAuth connection above: that OAuth
# flow requires an existing app login, so it can't be used to email someone
# who's locked out. Use any SMTP provider here — a transactional email
# service (Resend, SendGrid, Postmark all have free tiers) or a dedicated
# Gmail account with an "App Password" (myaccount.google.com/apppasswords).
# Don't reuse your outreach-sending Gmail account's normal password here.
# If left blank, reset links are logged to the server console instead of
# emailed — fine for local development, not for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Outreach CRM <no-reply@yourdomain.gr>"

# ---- Error monitoring (optional) ----
# If set, backend errors (unhandled request errors, scheduler failures,
# manual-send failures) are reported to Sentry instead of just console.error.
# Leave blank to disable entirely — nothing else changes without it.
SENTRY_DSN=

# ---- Lead integrations: Meta Lead Ads (optional) ----
# Only needed for the direct Meta Graph API integration (Integrations tab >
# Meta Lead Ads). See SETUP.md's "Lead integrations" section for the full
# Facebook App setup, including the App Review requirement before this works
# for pages you don't personally administer. The generic webhook integration
# (WordPress, Zapier/Make, any leadgen form) needs neither of these and works
# immediately with no setup here.
# From your Facebook App's dashboard > Settings > Basic.
META_APP_SECRET=
# Any string you make up yourself — enter this exact value into the Facebook
# App's Webhooks product when subscribing the /integrations/meta/webhook URL;
# Meta echoes it back on the verification handshake to prove you both agree
# on it.
META_VERIFY_TOKEN=

# ---- Lead integrations: LinkedIn Lead Gen Forms (optional) ----
# Only needed for the direct LinkedIn Lead Sync API integration (Integrations
# tab > LinkedIn Lead Gen Forms). See SETUP.md's "Lead integrations" section
# for the full LinkedIn Developer App setup, including its separate,
# application-based Lead Sync API access review — historically harder to get
# approved than Meta's App Review, with no guaranteed outcome or timeline.
# From your LinkedIn Developer App's Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/integrations/linkedin/callback
# LinkedIn's API is versioned by calendar month (e.g. "202601"); bump this
# periodically per their migration notices rather than leaving it stale.
LINKEDIN_API_VERSION=202601
